{
  "schemaVersion": 1,
  "id": "entityfinder",
  "version": "${version}",
  "name": "EntityFinder",
  "description": "Allows you to highlight select entities",
  "authors": [
    "JustAlittleWolf"
  ],
  "contact": {
    "sources": "https://github.com/JustAlittleWolf/EntityFinder"
  },
  "license": "MIT",
  "icon": "assets/entityfinder/icon.png",
  "environment": "client",
